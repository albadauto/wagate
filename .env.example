# Copie para .env e troque TODOS os valores antes de subir em produção.

# SQL Server
MSSQL_SA_PASSWORD=WaGate@2026!

# WAHA
WAHA_API_KEY=troque-esta-api-key-do-waha
WAHA_HMAC_KEY=troque-esta-chave-hmac-dos-webhooks
WAHA_DASHBOARD_USERNAME=wagate
WAHA_DASHBOARD_PASSWORD=troque-esta-senha
# Atenção: o WAHA troca valores "comuns" (admin, 123, waha...) por uma senha/chave aleatória.
# ATENÇÃO: o WAHA ignora valores "comuns" (admin, 123, waha...) e gera uma senha/chave aleatória no lugar.
# WEBJS (navegador real, mais pesado) | NOWEB | GOWS (leve, recomendado)
WHATSAPP_DEFAULT_ENGINE=GOWS

# API
JWT_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-64-caracteres-0000000000000
ADMIN_EMAIL=admin@wagate.local
ADMIN_PASSWORD=Admin@123456
ALLOW_REGISTRATION=true

# URL pela qual o navegador e os seus sistemas acessam a API
PUBLIC_API_URL=http://localhost:5080

# URL do painel (retornos do Stripe Checkout/Portal)
PUBLIC_APP_URL=http://localhost:5090

# Stripe — deixe vazio para rodar sem cobrança (limite por conta = MaxInstances)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
