<!DOCTYPE html>
<html lang="pt-BR" class="h-full">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="img/apple-touch-icon.png" />
    <meta name="theme-color" content="#01122f" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="h-full bg-navy-50 text-navy-950 antialiased">
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="js/app.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Sem pré-renderização: a sessão fica no localStorage, disponível só após o circuito conectar.
    private static readonly IComponentRenderMode PageRenderMode = new InteractiveServerRenderMode(prerender: false);
}
