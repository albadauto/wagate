@inject IJSRuntime JS

<button type="button" title="Copiar" class="rounded-md bg-white/10 p-2 text-navy-300 hover:bg-white/20 hover:text-white @Class" @onclick="Copy">
    <Icon Name="@(_copied ? "check" : "copy")" />
</button>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    private bool _copied;

    private async Task Copy()
    {
        await JS.InvokeVoidAsync("wagate.copy", Text);
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}
