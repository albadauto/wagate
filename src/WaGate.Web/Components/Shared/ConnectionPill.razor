@* Status no formato do painel: Conectada / Desconectada / Aguardando leitura *@
<span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold @Style">
    <span class="h-2 w-2 rounded-full @Dot"></span>@Label
</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    private (string Style, string Dot, string Label) Info => Status switch
    {
        "WORKING" => ("bg-brand-50 text-brand-700", "bg-brand-500", "Conectada"),
        "SCAN_QR_CODE" => ("bg-amber-50 text-amber-700", "bg-amber-400 animate-pulse", "Aguardando leitura do QR"),
        "STARTING" => ("bg-sky-50 text-sky-700", "bg-sky-400 animate-pulse", "Iniciando"),
        _ => ("bg-red-50 text-red-600", "bg-red-500", "Desconectada")
    };

    private string Style => Info.Style;
    private string Dot => Info.Dot;
    private string Label => Info.Label;
}
