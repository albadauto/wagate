@inject ApiClient Api

@* Diagnóstico da conexão API ↔ WAHA. Compacto = só aparece quando há problema. *@
@if (_s is not null && (!Compact || !_s.Reachable || !_s.ApiKeyValid))
{
    var ok = _s.Reachable && _s.ApiKeyValid;
    <div class="@(Compact ? "mb-6" : "") rounded-xl border p-5 text-sm @(ok ? "border-navy-100 bg-white" : "border-red-200 bg-red-50")">
        <div class="flex items-center gap-3">
            <span class="h-2.5 w-2.5 rounded-full @(ok ? "bg-brand-500" : "bg-red-500 animate-pulse")"></span>
            <span class="font-semibold text-navy-950">@(ok ? "WAHA conectado" : "Problema na conexão com o WAHA")</span>
            @if (_s.Version is not null) { <span class="text-xs text-navy-400">v@_s.Version · @_s.Engine</span> }
            <button class="ml-auto text-xs font-semibold text-brand-700 hover:underline" @onclick="Load">Testar de novo</button>
        </div>
        @if (_s.Error is not null)
        {
            <p class="mt-2 text-red-800">@_s.Error</p>
        }
        @if (!ok)
        {
            <ul class="mt-3 list-disc space-y-1 pl-5 text-navy-700">
                <li>O container do WAHA está rodando? <code class="code">docker compose ps</code></li>
                <li><code class="code">Waha:BaseUrl</code> da API aponta para <code class="code">@_s.BaseUrl</code></li>
                <li><code class="code">Waha:ApiKey</code> precisa ser igual ao <code class="code">WAHA_API_KEY</code> do container</li>
            </ul>
        }
        @if (!Compact)
        {
            <dl class="mt-4 grid gap-2 text-xs sm:grid-cols-2">
                <div><dt class="text-navy-400">URL do WAHA</dt><dd class="font-mono text-navy-700">@_s.BaseUrl</dd></div>
                <div><dt class="text-navy-400">Webhook (WAHA → API)</dt><dd class="truncate font-mono text-navy-700">@_s.WebhookUrl</dd></div>
                <div><dt class="text-navy-400">Assinatura HMAC</dt><dd class="text-navy-700">@(_s.HmacConfigured ? "Ativa" : "Desativada")</dd></div>
                <div><dt class="text-navy-400">Último evento recebido do WAHA</dt><dd class="text-navy-700">@(_s.LastWebhookReceivedAt?.ToLocalTime().ToString("dd/MM HH:mm:ss") ?? "nenhum ainda")</dd></div>
            </dl>
        }
    </div>
}

@code {
    [Parameter] public bool Compact { get; set; }
    private WahaStatusDto? _s;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try { _s = await Api.WahaStatusAsync(); }
        catch (ApiException ex) { _s = new WahaStatusDto(false, false, null, null, "?", "?", false, ex.Message, null); }
    }
}
