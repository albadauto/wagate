@inject ApiClient Api
@inject IConfiguration Config
@inject ToastService Toasts

<div class="grid gap-6 lg:grid-cols-5">
    <div class="min-w-0 space-y-6 lg:col-span-3">
        <div class="card overflow-hidden">
            <div class="flex items-center gap-1 border-b border-navy-100 px-4 pt-3">
                @foreach (var s in Samples.Keys)
                {
                    <button class="rounded-t-md px-3 py-2 text-xs font-medium @(_sample == s ? "bg-navy-900 text-white" : "text-navy-500 hover:text-navy-800")" @onclick="() => _sample = s">@s</button>
                }
            </div>
            <div class="relative bg-navy-900">
                <pre class="overflow-x-auto px-5 pb-5 pt-12 font-mono text-[12.5px] leading-relaxed text-navy-200">@Samples[_sample]</pre>
                <div class="absolute right-3 top-3 w-10"><CopyButton Text="@Samples[_sample]" /></div>
            </div>
        </div>
    </div>

    <div class="min-w-0 lg:col-span-2">
        <div class="card p-6">
            <h2 class="font-semibold">Enviar mensagem de teste</h2>
            <p class="mt-1 text-sm text-navy-500">Dispara um texto pela instância usando a API.</p>
            <EditForm Model="_test" OnValidSubmit="SendTest" FormName="send-test" class="mt-5 space-y-4">
                <DataAnnotationsValidator />
                <div>
                    <label class="label">Telefone (com DDI)</label>
                    <InputText @bind-Value="_test.Phone" class="input" placeholder="5511999999999" />
                    <ValidationMessage For="() => _test.Phone" class="field-error" />
                </div>
                <div>
                    <label class="label">Mensagem</label>
                    <InputTextArea @bind-Value="_test.Message" rows="4" class="input" />
                    <ValidationMessage For="() => _test.Message" class="field-error" />
                </div>
                <button class="btn-primary w-full" type="submit" disabled="@(_busy || Instance.Status != "WORKING")">
                    @if (_busy) { <Spinner Class="h-4 w-4 text-navy-950" /> } else { <Icon Name="send" /> } Enviar
                </button>
                @if (Instance.Status != "WORKING")
                {
                    <p class="text-center text-xs text-amber-700">Conecte a instância para enviar mensagens.</p>
                }
                @if (_lastId is not null)
                {
                    <p class="text-center text-xs text-navy-500">Enviada · id <span class="font-mono">@_lastId</span></p>
                }
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public InstanceDto Instance { get; set; } = default!;

    private AccountDto? _account;
    private string _sample = "cURL";
    private readonly SendTextRequest _test = new() { Message = "Olá! Mensagem de teste enviada pelo WaGate ✅" };
    private bool _busy;
    private string? _lastId;

    private string PublicUrl => (Config["Api:PublicUrl"] ?? Config["Api:BaseUrl"] ?? "http://localhost:5080").TrimEnd('/');
    private string BaseUrl => $"{PublicUrl}/instances/{Instance.Id}/token/{Instance.Token}";
    // o valor real fica só no campo mascarado acima; os exemplos usam um marcador
    private const string ClientToken = "SEU_CLIENT_TOKEN";

    private Dictionary<string, string> Samples => new()
    {
        ["cURL"] = $$"""
            curl -X POST "{{BaseUrl}}/send-text" \
              -H "Content-Type: application/json" \
              -H "Client-Token: {{ClientToken}}" \
              -d '{ "phone": "5511999999999", "message": "Olá do WaGate!" }'
            """,
        ["Imagem"] = $$"""
            curl -X POST "{{BaseUrl}}/send-image" \
              -H "Content-Type: application/json" \
              -H "Client-Token: {{ClientToken}}" \
              -d '{
                "phone": "5511999999999",
                "url": "https://picsum.photos/800/600.jpg",
                "caption": "Segue a imagem 📷"
              }'
            """,
        ["C#"] = $$"""
            using System.Net.Http.Json;

            var http = new HttpClient { BaseAddress = new Uri("{{BaseUrl}}/") };
            http.DefaultRequestHeaders.Add("Client-Token", "{{ClientToken}}");

            var res = await http.PostAsJsonAsync("send-text", new
            {
                phone = "5511999999999",
                message = "Olá do WaGate!",
                delayTyping = 2
            });
            res.EnsureSuccessStatusCode();
            Console.WriteLine(await res.Content.ReadAsStringAsync());
            // { "zaapId": "...", "messageId": "...", "id": "..." }
            """,
        ["Node.js"] = $$"""
            const res = await fetch("{{BaseUrl}}/send-text", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Client-Token": "{{ClientToken}}"
              },
              body: JSON.stringify({ phone: "5511999999999", message: "Olá do WaGate!" })
            });
            console.log(await res.json());
            """
    };

    protected override async Task OnInitializedAsync()
    {
        try { _account = await Api.MeAsync(); }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
    }

    private async Task SendTest()
    {
        _busy = true;
        try
        {
            var r = await Api.SendTextAsync(Instance.Id, _test);
            _lastId = r.MessageId ?? r.Id;
            Toasts.Success("Mensagem enviada.");
        }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }
}
