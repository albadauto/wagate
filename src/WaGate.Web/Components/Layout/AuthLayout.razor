@inherits LayoutComponentBase

<div class="grid min-h-screen lg:grid-cols-2">
    <section class="relative hidden overflow-hidden bg-navy-950 p-12 text-navy-200 lg:flex lg:flex-col lg:justify-between">
        <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand-500/20 blur-3xl"></div>
        <div class="absolute -bottom-40 left-10 h-96 w-96 rounded-full bg-brand-400/10 blur-3xl"></div>
        <div class="relative"><img src="img/logo-light.png" alt="WaGate" class="h-9 w-auto" /></div>
        <div class="relative max-w-md">
            <h2 class="text-3xl font-semibold leading-tight text-white">Sua API de WhatsApp, rodando na sua infraestrutura.</h2>
            <p class="mt-4 text-navy-400">Instâncias multi-número sobre o WAHA, envio de mensagens e mídia, e webhooks assinados com retentativa automática.</p>
            <div class="mt-8 rounded-xl border border-navy-800 bg-navy-900/60 p-4 font-mono text-[12.5px] leading-relaxed">
                <span class="text-brand-400">POST</span> /instances/<span class="text-navy-500">{id}</span>/token/<span class="text-navy-500">{token}</span>/send-text<br />
                <span class="text-navy-500">{</span> <span class="text-sky-300">"phone"</span>: <span class="text-amber-200">"5511999999999"</span>, <span class="text-sky-300">"message"</span>: <span class="text-amber-200">"Olá!"</span> <span class="text-navy-500">}</span>
            </div>
        </div>
        <p class="relative text-xs text-navy-600">ASP.NET Core · Blazor · SQL Server · WAHA</p>
    </section>
    <section class="flex items-center justify-center px-6 py-12">
        <div class="w-full max-w-md"><img src="img/logo.png" alt="WaGate" class="mb-10 h-8 w-auto lg:hidden" />@Body</div>
    </section>
</div>
<Toasts />
