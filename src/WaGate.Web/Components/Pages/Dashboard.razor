@page "/overview"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>Visão geral · WaGate</PageTitle>

<PageHeader Title="Visão geral" Subtitle="Saúde das suas instâncias e do tráfego de mensagens." />

@if (_data is null)
{
    <div class="flex justify-center py-20"><Spinner /></div>
}
else
{
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="card p-5">
            <div class="text-sm text-navy-500">Instâncias conectadas</div>
            <div class="mt-2 flex items-baseline gap-1.5">
                <span class="text-3xl font-semibold tabular-nums">@_data.InstancesConnected</span>
                <span class="text-sm text-navy-400">de @_data.Instances</span>
            </div>
        </div>
        <div class="card p-5">
            <div class="text-sm text-navy-500">Mensagens hoje</div>
            <div class="mt-2 text-3xl font-semibold tabular-nums">@_data.MessagesToday</div>
            <div class="mt-1 flex gap-3 text-xs text-navy-500">
                <span class="inline-flex items-center gap-1"><Icon Name="arrow-in" Class="h-3 w-3 text-violet-500" /> @_data.MessagesInboundToday recebidas</span>
                <span class="inline-flex items-center gap-1"><Icon Name="arrow-out" Class="h-3 w-3 text-brand-600" /> @_data.MessagesOutboundToday enviadas</span>
            </div>
        </div>
        <div class="card p-5">
            <div class="text-sm text-navy-500">Entregas de webhook (24h)</div>
            <div class="mt-2 text-3xl font-semibold tabular-nums @(_data.DeliverySuccessRate24h < 95 ? "text-amber-600" : "")">@_data.DeliverySuccessRate24h.ToString("0.#")%</div>
            <div class="mt-1 text-xs text-navy-500">taxa de sucesso</div>
        </div>
        <a href="deliveries" class="card p-5 transition hover:ring-brand-500/40">
            <div class="text-sm text-navy-500">Na fila / com falha</div>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-3xl font-semibold tabular-nums">@_data.DeliveriesPending</span>
                @if (_data.DeliveriesFailed24h > 0)
                {
                    <span class="rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">@_data.DeliveriesFailed24h falhas</span>
                }
            </div>
            <div class="mt-1 text-xs text-navy-500">ver entregas →</div>
        </a>
    </div>

    <div class="mt-6"><WahaHealth /></div>

    <div class="card mt-6 p-6">
        <div class="flex items-center justify-between">
            <h2 class="font-semibold">Mensagens nos últimos 7 dias</h2>
            <div class="flex gap-4 text-xs text-navy-500">
                <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-brand-500"></span>Enviadas</span>
                <span class="inline-flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm bg-violet-400"></span>Recebidas</span>
            </div>
        </div>
        <div class="mt-6 flex h-48 items-end gap-3">
            @foreach (var d in _data.Last7Days)
            {
                var max = Math.Max(1, _data.Last7Days.Max(x => Math.Max(x.Inbound, x.Outbound)));
                <div class="group flex flex-1 flex-col items-center gap-2">
                    <div class="relative flex h-40 w-full items-end justify-center gap-1">
                        <div class="w-1/3 max-w-5 rounded-t bg-brand-500 transition-all" style="height:@Pct(d.Outbound, max)%" title="@d.Outbound enviadas"></div>
                        <div class="w-1/3 max-w-5 rounded-t bg-violet-400 transition-all" style="height:@Pct(d.Inbound, max)%" title="@d.Inbound recebidas"></div>
                        <div class="pointer-events-none absolute -top-6 hidden rounded bg-navy-900 px-1.5 py-0.5 text-[11px] text-white group-hover:block">@(d.Inbound + d.Outbound)</div>
                    </div>
                    <span class="text-xs text-navy-500">@d.Day.ToString("ddd dd", Br)</span>
                </div>
            }
        </div>
    </div>

    @if (_data.Instances == 0)
    {
        <div class="mt-6">
            <EmptyState Title="Crie sua primeira instância" Text="Uma instância é um número de WhatsApp conectado. Depois de criada, leia o QR Code com o celular.">
                <a href="" class="btn-primary"><Icon Name="plus" /> Nova instância</a>
            </EmptyState>
        </div>
    }
}

@code {
    private static readonly System.Globalization.CultureInfo Br = new("pt-BR");
    private DashboardDto? _data;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _timer = new Timer(_ => InvokeAsync(async () => { await Load(); StateHasChanged(); }), null, 30_000, 30_000);
    }

    private async Task Load()
    {
        try { _data = await Api.DashboardAsync(); }
        catch (ApiException ex) { Toasts.Error(ex.Message); _data ??= new DashboardDto(0, 0, 0, 0, 0, 0, 0, 100, []); }
    }

    private static double Pct(int v, int max) => v == 0 ? 2 : Math.Round(v * 100.0 / max, 1);

    public void Dispose() => _timer?.Dispose();
}
