@page "/billing"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService Toasts
@inject SubscriptionState Subscription
@inject NavigationManager Nav

<PageTitle>Plano e cobrança · WaGate</PageTitle>

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-navy-950 outline-none" tabindex="-1">Plano e cobrança</h1>
        <p class="mt-1 text-sm text-navy-500">Sua assinatura, limite de instâncias e faturas.</p>
    </div>
    <a href="plans" class="btn-secondary">Ver planos</a>
</div>

@if (_sub is null)
{
    <div class="flex justify-center py-20"><Spinner /></div>
}
else if (!_sub.BillingEnabled)
{
    <div class="card p-6 text-sm text-navy-600">A cobrança não está configurada neste servidor. Limite atual: <b>@_sub.InstanceLimit</b> instância(s).</div>
}
else if (!_sub.IsUsable)
{
    <div class="card flex flex-col items-center p-10 text-center">
        <div class="grid h-14 w-14 place-items-center rounded-full bg-brand-50 text-brand-600"><Icon Name="zap" Class="h-6 w-6" /></div>
        <h2 class="mt-4 text-lg font-bold">@(_sub.Status is "canceled" ? "Sua assinatura foi cancelada" : "Você ainda não tem um plano")</h2>
        <p class="mt-1 max-w-md text-sm text-navy-500">
            @(_sub.TrialAvailable ? "Comece com 7 dias grátis no Ultimate. O cartão é pedido agora, mas nada é cobrado durante o teste." : "Escolha um plano para voltar a usar suas instâncias.")
        </p>
        <a href="plans" class="btn-primary mt-6">@(_sub.TrialAvailable ? "Começar teste grátis" : "Escolher plano")</a>
        @if (_sub.HasStripeCustomer)
        {
            <button class="mt-3 text-sm font-semibold text-brand-700 hover:underline" @onclick="Portal">Ver faturas anteriores</button>
        }
    </div>
}
else
{
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="card p-6 lg:col-span-2">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <div class="text-sm font-bold uppercase tracking-[0.2em] text-brand-700">Plano @_sub.Plan</div>
                    <div class="mt-2 text-3xl font-extrabold tracking-tight text-navy-950">@Money.Brl(UnitAmount * _sub.Quantity)<span class="text-base font-medium text-navy-500"> /mês</span></div>
                    <div class="mt-1 text-sm text-navy-500">@_sub.Quantity instância(s) × @Money.Brl(UnitAmount)</div>
                </div>
                <BillingStatusPill Status="@_sub.Status" />
            </div>

            @if (_sub.Status == "trialing" && _sub.TrialEndsAt is not null)
            {
                var days = Math.Max(0, (int)Math.Ceiling((_sub.TrialEndsAt.Value - DateTime.UtcNow).TotalDays));
                <div class="mt-6 rounded-xl bg-brand-50 p-4 text-sm text-brand-900">
                    <b>Teste grátis:</b> faltam @days dia(s). A primeira cobrança será em <b>@Money.Date(_sub.TrialEndsAt)</b>.
                </div>
            }
            @if (_sub.Status == "past_due")
            {
                <div class="mt-6 rounded-xl bg-red-50 p-4 text-sm text-red-800">
                    <b>Pagamento pendente.</b> Atualize o cartão para não perder o acesso às instâncias.
                    <button class="ml-1 font-semibold underline" @onclick="Portal">Atualizar pagamento</button>
                </div>
            }
            @if (_sub.CancelAtPeriodEnd)
            {
                <div class="mt-6 rounded-xl bg-amber-50 p-4 text-sm text-amber-900">
                    A assinatura será encerrada em <b>@Money.Date(_sub.CurrentPeriodEnd)</b>. Reative pelo portal do Stripe se mudar de ideia.
                </div>
            }

            <div class="mt-6">
                <div class="flex justify-between text-sm"><span class="text-navy-600">Instâncias em uso</span><span class="font-semibold">@_sub.InstancesUsed de @_sub.InstanceLimit</span></div>
                <div class="mt-2 h-2 overflow-hidden rounded-full bg-navy-100">
                    <div class="h-full rounded-full @(_sub.InstancesUsed >= _sub.InstanceLimit ? "bg-amber-500" : "bg-brand-500")" style="width:@Pct%"></div>
                </div>
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-navy-100 pt-6">
                <span class="text-sm text-navy-600">Alterar quantidade:</span>
                <div class="flex items-center rounded-lg ring-1 ring-navy-200">
                    <button class="px-3 py-1.5 text-lg leading-none disabled:opacity-30" disabled="@(_qty <= Min)" @onclick="() => _qty--">−</button>
                    <input class="w-16 border-0 bg-transparent text-center font-bold tabular-nums focus:outline-none" type="number" min="@Min" max="@Max" @bind="_qty" />
                    <button class="px-3 py-1.5 text-lg leading-none disabled:opacity-30" disabled="@(_qty >= Max)" @onclick="() => _qty++">+</button>
                </div>
                <button class="btn-primary" disabled="@(_busy || _qty == _sub.Quantity || _qty < Min || _qty > Max)" @onclick="ChangeQty">Atualizar</button>
                <span class="text-xs text-navy-400">Cobrança proporcional na próxima fatura.</span>
            </div>
        </div>

        <div class="space-y-6">
            <div class="card p-6 text-sm">
                <h2 class="font-bold text-navy-950">Próxima cobrança</h2>
                <div class="mt-3 text-2xl font-bold">@Money.Date(_sub.Status == "trialing" ? _sub.TrialEndsAt : _sub.CurrentPeriodEnd)</div>
                <p class="mt-1 text-navy-500">@Money.Brl(UnitAmount * _sub.Quantity) no cartão cadastrado</p>
            </div>
            <div class="card p-6 text-sm">
                <h2 class="font-bold text-navy-950">Pagamento e faturas</h2>
                <p class="mt-1 text-navy-500">Troque o cartão, baixe notas e faturas ou cancele a assinatura no portal seguro do Stripe.</p>
                <button class="btn-secondary mt-4 w-full" disabled="@_busy" @onclick="Portal">Abrir portal de pagamento</button>
            </div>
        </div>
    </div>
}

@code {
    private SubscriptionDto? _sub;
    private List<PlanDto> _plans = [];
    private int _qty;
    private bool _busy;

    private PlanDto? Plan => _plans.FirstOrDefault(p => p.Key == _sub?.Plan);
    private long UnitAmount => Plan?.UnitAmount ?? 0;
    private int Min => Math.Max(Plan?.MinQuantity ?? 1, _sub?.InstancesUsed ?? 0);
    private int Max => Plan?.MaxQuantity ?? 1;
    private int Pct => _sub is null || _sub.InstanceLimit == 0 ? 0 : Math.Min(100, _sub.InstancesUsed * 100 / _sub.InstanceLimit);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _plans = await Api.PlansAsync();
            _sub = await Subscription.LoadAsync(force: true);
            _qty = _sub?.Quantity ?? 1;
        }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
    }

    private async Task ChangeQty()
    {
        _busy = true;
        try
        {
            _sub = await Api.ChangePlanAsync(_sub!.Plan, _qty);
            Subscription.Set(_sub);
            Toasts.Success("Quantidade atualizada.");
        }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task Portal()
    {
        _busy = true;
        try { Nav.NavigateTo((await Api.PortalAsync()).Url, forceLoad: true); }
        catch (ApiException ex) { Toasts.Error(ex.Message); _busy = false; }
    }
}
