@page "/security"
@page "/account"
@attribute [Authorize]
@inject ApiClient Api
@inject ToastService Toasts

<PageTitle>Segurança · WaGate</PageTitle>

<div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-navy-950 outline-none" tabindex="-1">Segurança</h1>
    <p class="mt-1 text-sm text-navy-500">Proteja o acesso às suas instâncias.</p>
</div>

@if (_account is null)
{
    <div class="flex justify-center py-20"><Spinner /></div>
}
else
{
    <div class="grid gap-6 lg:grid-cols-3">
        <div class="card lg:col-span-2">
            <div class="flex items-start justify-between gap-4 border-b border-navy-100 px-6 py-5">
                <div class="flex gap-4">
                    <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon Name="key" Class="h-5 w-5" /></div>
                    <div>
                        <h2 class="font-bold text-navy-950">Token de segurança da conta</h2>
                        <p class="mt-0.5 text-sm text-navy-500">Uma camada extra de proteção: com o token ativo, toda chamada às suas instâncias precisa enviar o header <code class="code">Client-Token</code>.</p>
                    </div>
                </div>
                @if (_account.ClientTokenEnabled)
                {
                    <span class="shrink-0 rounded-full bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">Ativo</span>
                }
                else
                {
                    <span class="shrink-0 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">Desativado</span>
                }
            </div>

            <div class="px-6 py-5">
                <CopyField Label="Token" Value="@_account.ClientToken" Masked="true" />

                @if (!_account.ClientTokenEnabled)
                {
                    <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                        <b>Antes de ativar:</b> configure seu sistema para enviar o header abaixo em todas as requisições. Assim que ativar, as chamadas sem o token passam a receber <b>401</b>.
                    </div>
                }
                <pre class="mt-5 overflow-x-auto rounded-xl bg-navy-900 p-4 font-mono text-[12.5px] text-navy-200">Client-Token: <span class="text-brand-300">SEU_TOKEN</span></pre>

                <div class="mt-5 flex flex-wrap gap-2">
                    @if (_account.ClientTokenEnabled)
                    {
                        <button class="btn-secondary" disabled="@_busy" @onclick="() => _confirmDisable = true">Desativar token</button>
                    }
                    else
                    {
                        <button class="btn-primary" disabled="@_busy" @onclick="() => SetState(true)"><Icon Name="check" /> Ativar token</button>
                    }
                    <button class="btn-secondary" disabled="@_busy" @onclick="() => _confirmRotate = true"><Icon Name="refresh" /> Gerar novo token</button>
                </div>
            </div>
        </div>

        <div class="card p-6">
            <h2 class="font-bold text-navy-950">Conta</h2>
            <dl class="mt-4 space-y-3 text-sm">
                <div><dt class="text-xs text-navy-500">Nome</dt><dd class="font-medium">@_account.Name</dd></div>
                <div><dt class="text-xs text-navy-500">E-mail</dt><dd>@_account.Email</dd></div>
                <div><dt class="text-xs text-navy-500">Limite de instâncias</dt><dd>@_account.MaxInstances</dd></div>
                <div><dt class="text-xs text-navy-500">Cliente desde</dt><dd>@_account.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd></div>
            </dl>
        </div>
    </div>
}

<Modal @bind-Open="_confirmDisable" Title="Desativar o token de segurança?">
    <ChildContent><p class="text-sm text-navy-600">As instâncias passarão a aceitar chamadas apenas com ID e token da instância na URL. Recomendamos manter o token ativo.</p></ChildContent>
    <Footer>
        <button class="btn-secondary" @onclick="() => _confirmDisable = false">Cancelar</button>
        <button class="btn-danger" @onclick="() => SetState(false)">Desativar</button>
    </Footer>
</Modal>

<Modal @bind-Open="_confirmRotate" Title="Gerar novo token?">
    <ChildContent><p class="text-sm text-navy-600">O token atual deixa de funcionar imediatamente em todas as instâncias da conta.</p></ChildContent>
    <Footer>
        <button class="btn-secondary" @onclick="() => _confirmRotate = false">Cancelar</button>
        <button class="btn-primary" @onclick="Rotate">Gerar novo token</button>
    </Footer>
</Modal>

@code {
    private AccountDto? _account;
    private bool _busy, _confirmDisable, _confirmRotate;

    protected override async Task OnInitializedAsync()
    {
        try { _account = await Api.MeAsync(); }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
    }

    private async Task SetState(bool enabled)
    {
        _confirmDisable = false;
        _busy = true;
        try
        {
            _account = await Api.SetClientTokenStateAsync(enabled);
            Toasts.Success(enabled ? "Token de segurança ativado." : "Token de segurança desativado.");
        }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
        finally { _busy = false; }
    }

    private async Task Rotate()
    {
        _confirmRotate = false;
        try { _account = await Api.RotateClientTokenAsync(); Toasts.Success("Novo token gerado."); }
        catch (ApiException ex) { Toasts.Error(ex.Message); }
    }
}
