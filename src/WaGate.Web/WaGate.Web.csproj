<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <TailwindInput>Styles/app.css</TailwindInput>
    <TailwindOutput>wwwroot/app.css</TailwindOutput>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WaGate.Shared\WaGate.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="node_modules\**" />
    <None Remove="node_modules\**" />
    <Content Remove="package*.json" />
    <None Include="package.json" />
    <Watch Include="Styles\**\*.css" />
  </ItemGroup>

  <!--
    Recompila o Tailwind a cada build quando as dependências do npm estiverem instaladas
    (cd src/WaGate.Web && npm install). Sem Node, usa o app.css já gerado e versionado.
  -->
  <Target Name="TailwindBuild" BeforeTargets="BeforeBuild" Condition="Exists('node_modules/.bin/tailwindcss') Or Exists('node_modules\.bin\tailwindcss.cmd')">
    <Exec Command="npx tailwindcss -i $(TailwindInput) -o $(TailwindOutput) --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
